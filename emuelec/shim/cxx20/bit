// <bit> de C++20 para el libstdc++ 8 del sysroot Debian buster, que no lo trae.
// Solo lo que el proyecto usa (bit_cast, popcount) y unas pocas funciones vecinas.
#pragma once
#include <cstdint>
#include <type_traits>

namespace std {

template <class To, class From>
constexpr To bit_cast(const From& from) noexcept {
    static_assert(sizeof(To) == sizeof(From), "bit_cast: tamanos distintos");
    return __builtin_bit_cast(To, from);
}

template <class T> constexpr int popcount(T x) noexcept {
    return sizeof(T) > 4 ? __builtin_popcountll((unsigned long long)x) : __builtin_popcount((unsigned)x);
}
template <class T> constexpr int countl_zero(T x) noexcept {
    constexpr int bits = int(sizeof(T) * 8);
    if (x == 0) return bits;
    return sizeof(T) > 4 ? __builtin_clzll((unsigned long long)x) - (64 - bits)
                         : __builtin_clz((unsigned)x) - (32 - bits);
}
template <class T> constexpr int countr_zero(T x) noexcept {
    constexpr int bits = int(sizeof(T) * 8);
    if (x == 0) return bits;
    return sizeof(T) > 4 ? __builtin_ctzll((unsigned long long)x) : __builtin_ctz((unsigned)x);
}
template <class T> constexpr bool has_single_bit(T x) noexcept { return x != 0 && (x & (x - 1)) == 0; }
template <class T> constexpr T rotl(T x, int s) noexcept {
    constexpr int n = int(sizeof(T) * 8);
    s %= n;
    return s == 0 ? x : T((x << s) | (x >> (n - s)));
}
template <class T> constexpr T rotr(T x, int s) noexcept {
    constexpr int n = int(sizeof(T) * 8);
    s %= n;
    return s == 0 ? x : T((x >> s) | (x << (n - s)));
}

enum class endian { little = __ORDER_LITTLE_ENDIAN__, big = __ORDER_BIG_ENDIAN__, native = __BYTE_ORDER__ };

}  // namespace std
